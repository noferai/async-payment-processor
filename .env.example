# Необязательный файл: скопируйте в .env и раскомментируйте то, что нужно переопределить.
# Без .env используются значения по умолчанию из кода (указаны ниже).

# Порты на машине разработчика (docker-compose.yml)
# API_PORT=8000
# RABBITMQ_UI_PORT=15672

# Подключения. В docker compose DATABASE_URL и RABBITMQ_URL заданы в самом
# docker-compose.yml и указывают на сервисы postgres и rabbitmq.
# DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
# RABBITMQ_URL=amqp://payments:payments@localhost:5672/
# API_KEY=dev-api-key
# DB_POOL_SIZE=15

# Эмуляция платёжного шлюза
# GATEWAY_MIN_DELAY_SECONDS=2.0
# GATEWAY_MAX_DELAY_SECONDS=5.0
# GATEWAY_SUCCESS_RATE=0.9

# WEBHOOK_TIMEOUT_SECONDS=5.0

# Повторные попытки обработки: всего доставок = RETRY_MAX_ATTEMPTS,
# задержки = RETRY_BASE_DELAY_MS * RETRY_MULTIPLIER**i
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=2000
# RETRY_MULTIPLIER=2
# CONSUMER_PREFETCH=10

# Outbox-релей
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_INTERVAL_SECONDS=1.0
# OUTBOX_MAX_BACKOFF_SECONDS=30.0
# PUBLISH_TIMEOUT_SECONDS=5.0
